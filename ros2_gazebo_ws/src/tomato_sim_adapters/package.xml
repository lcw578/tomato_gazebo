<?xml version="1.0"?>
<package format="3">
  <name>tomato_sim_adapters</name>
  <version>0.1.0</version>
  <description>Gazebo adapters for the tomato picker ROS 2 hardware interfaces.</description>
  <maintainer email="lcw@localhost.localdomain">lcw</maintainer>
  <license>See project asset terms</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
