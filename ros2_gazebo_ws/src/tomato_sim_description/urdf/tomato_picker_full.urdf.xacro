<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tomato_picker">
  <xacro:arg name="lift_height" default="0.0"/>
  <xacro:arg name="camera_angle_deg" default="14.0"/>
  <xacro:arg name="camera_hfov_deg" default="70.0"/>
  <xacro:arg name="camera_tilt_deg" default="0.0"/>
  <xacro:arg name="self_collide" default="true"/>
  <xacro:arg name="slide_min" default="-2.5"/>
  <xacro:arg name="slide_max" default="2.5"/>
  <xacro:arg name="slide_initial" default="0.0"/>
  <!-- User installation: 180 degrees keeps the arm clear of the scene cameras. -->
  <xacro:arg name="arm_base_yaw_deg" default="180.0"/>
  <xacro:arg name="cameras" default="true"/>
  <xacro:arg name="left_camera" default="true"/>
  <xacro:arg name="right_camera" default="true"/>
  <xacro:arg name="hand_camera" default="true"/>
  <xacro:arg name="camera_rate" default="15"/>
  <xacro:include filename="$(find aubo_description)/xacro/aubo_i5_arm.xacro"/>
  <xacro:include filename="mujoco_cad.xacro"/>
  <xacro:include filename="tomato_control.xacro"/>

  <xacro:macro name="fixed" params="name parent child xyz:='0 0 0' rpy:='0 0 0'">
    <joint name="${name}" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="${parent}"/>
      <child link="${child}"/>
    </joint>
  </xacro:macro>
  <xacro:macro name="box_collision" params="name xyz size">
    <collision name="${name}">
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <geometry><box size="${size}"/></geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="frame_inertial">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </xacro:macro>

  <link name="world"/>
  <link name="track_world">
    <!-- Keep the fixed ODE anchor comparable to the carriage in mass and inertia. -->
    <inertial>
      <mass value="200"/>
      <inertia ixx="50" ixy="0" ixz="0" iyy="50" iyz="0" izz="50"/>
    </inertial>
  </link>
  <gazebo reference="track_anchor"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
  <xacro:fixed name="track_anchor" parent="world" child="track_world"/>
  <link name="robot_carriage"><xacro:frame_inertial/></link>
  <link name="chassis_cad_datum">
    <xacro:chassis_cad/>
    <!-- The chassis shell uses a simplified collision envelope. -->
    <xacro:box_collision name="chassis_shell" xyz="0 0 -0.26" size="1.26 0.79 0.42"/>
  </link>
  <joint name="machine_slide" type="prismatic">
    <parent link="track_world"/>
    <child link="robot_carriage"/>
    <!-- The same frame, axis and limits as robot_track_mount.urdf.xacro. -->
    <origin xyz="0 0 0.040" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="$(arg slide_min)" upper="$(arg slide_max)" effort="1000" velocity="0.5"/>
    <dynamics damping="2"/>
  </joint>
  <!-- The standalone CAD datum is rolled by pi and placed at 0.066379 m. -->
  <xacro:fixed name="chassis_datum_offset" parent="robot_carriage" child="chassis_cad_datum"
               xyz="0 0 0.026379" rpy="${pi} 0 0"/>
  <xacro:chassis_wheels/>
  <link name="basket_link"><xacro:basket_cad/></link>
  <joint name="basket_mount" type="fixed">
    <parent link="chassis_cad_datum"/>
    <child link="basket_link"/>
    <xacro:basket_origin/>
  </joint>
  <link name="lift_platform">
    <xacro:lift_cad/>
    <xacro:box_collision name="lift_deck" xyz="0 0 -0.6589" size="1.30 0.39 0.056"/>
  </link>
  <xacro:fixed name="lift_mount" parent="chassis_cad_datum" child="lift_platform"
               xyz="0 0 ${-float('$(arg lift_height)')}"/>

  <xacro:aubo_i5_arm base="arm_base_link"/>
  <xacro:fixed name="arm_mount" parent="lift_platform" child="arm_base_link"
               xyz="0.002 0.004 -0.704"
               rpy="${pi} 0 ${float('$(arg arm_base_yaw_deg)') * pi/180}"/>
  <!-- Position-only simulation control stands in for the real arm's gravity compensation. -->
  <gazebo reference="shoulder_Link"><gravity>false</gravity></gazebo>
  <gazebo reference="upperArm_Link"><gravity>false</gravity></gazebo>
  <gazebo reference="foreArm_Link"><gravity>false</gravity></gazebo>
  <gazebo reference="wrist1_Link"><gravity>false</gravity></gazebo>
  <gazebo reference="wrist2_Link"><gravity>false</gravity></gazebo>
  <gazebo reference="wrist3_Link"><gravity>false</gravity></gazebo>
  <gazebo reference="left_finger_link"><gravity>false</gravity></gazebo>
  <gazebo reference="right_finger_link"><gravity>false</gravity></gazebo>
  <link name="flange_link"/>
  <joint name="flange_mount" type="fixed">
    <parent link="wrist3_Link"/>
    <child link="flange_link"/>
    <xacro:flange_origin/>
  </joint>
  <link name="cutter_base_link">
    <xacro:cutter_cad/>
    <xacro:box_collision name="cutter_housing" xyz="0 0 0.019" size="0.074 0.104 0.047"/>
  </link>
  <joint name="cutter_mount" type="fixed">
    <parent link="flange_link"/>
    <child link="cutter_base_link"/>
    <xacro:cutter_origin/>
  </joint>
  <link name="tool_tcp"/>
  <!-- Same blade reference as contact_tcp used by the previous simulation. -->
  <xacro:fixed name="tool_tcp_mount" parent="cutter_base_link" child="tool_tcp"
               xyz="-0.0049 -0.0044 -0.085"/>
  <link name="cutter_gear_link"><xacro:gear_cad/></link>
  <joint name="gripper_joint" type="revolute">
    <parent link="cutter_base_link"/>
    <child link="cutter_gear_link"/>
    <xacro:gear_origin/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.474409" upper="0.463234" effort="2" velocity="2.0"/>
    <dynamics damping="0.002" friction="0.005"/>
  </joint>
  <link name="left_finger_link">
    <xacro:left_finger_cad/>
    <xacro:box_collision name="left_blade" xyz="0.009 0.065 -0.026"
                         size="0.020 0.071 0.004"/>
    <!-- Exact 0.2 mm CAD insert used as MuJoCo contact_blade. -->
    <collision name="mujoco_contact_blade">
      <origin xyz="0.042380645 -0.079623834 -0.06351737"
              rpy="1.5710562 -0.000000071387875 -0.00027471871"/>
      <geometry>
        <mesh filename="package://tomato_sim_description/meshes/gripper/part_005_solid_005.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <link name="right_finger_link">
    <xacro:right_finger_cad/>
    <xacro:box_collision name="right_blade" xyz="-0.013 -0.065 -0.025"
                         size="0.020 0.071 0.004"/>
  </link>
  <joint name="left_finger_joint" type="prismatic">
    <parent link="cutter_base_link"/>
    <child link="left_finger_link"/>
    <xacro:left_finger_origin/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.012610" upper="0.011837" effort="50" velocity="0.045"/>
    <dynamics damping="0.05"/>
    <mimic joint="gripper_joint" multiplier="-0.020999"/>
  </joint>
  <joint name="right_finger_joint" type="prismatic">
    <parent link="cutter_base_link"/>
    <child link="right_finger_link"/>
    <xacro:right_finger_origin/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.010648" upper="0.010883" effort="50" velocity="0.045"/>
    <dynamics damping="0.05"/>
    <mimic joint="gripper_joint" multiplier="-0.020995"/>
  </joint>
  <gazebo reference="left_finger_link">
    <sensor name="mujoco_contact_blade_sensor" type="contact">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <!-- SDFormat's URDF importer renames collisions when reducing fixed joints. -->
      <contact><collision>left_finger_link_fixed_joint_lump__mujoco_contact_blade_collision_1</collision></contact>
      <plugin name="mujoco_contact_blade_ros" filename="libgazebo_ros_bumper.so">
        <ros><namespace>/sim/harvest</namespace>
             <remapping>bumper_states:=blade_contacts</remapping></ros>
        <frame_name>world</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <xacro:macro name="rgbd_camera" params="name hfov width height near far enabled">
    <link name="${name}_color_optical_frame"/>
    <xacro:fixed name="${name}_optical_mount" parent="${name}_link"
                 child="${name}_color_optical_frame" rpy="${-pi/2} 0 ${-pi/2}"/>
    <xacro:if value="$(arg cameras)">
      <xacro:if value="${enabled}">
        <gazebo reference="${name}_link">
          <sensor name="${name}_rgbd" type="depth">
            <always_on>true</always_on>
            <update_rate>${float('$(arg camera_rate)')}</update_rate>
            <camera name="${name}">
              <horizontal_fov>${hfov}</horizontal_fov>
              <image><width>${width}</width><height>${height}</height><format>R8G8B8</format></image>
              <clip><near>${near}</near><far>${far}</far></clip>
            </camera>
            <plugin name="${name}_ros" filename="libgazebo_ros_camera.so">
              <ros><namespace>/sim</namespace></ros>
              <camera_name>${name}</camera_name>
              <frame_name>${name}_color_optical_frame</frame_name>
              <min_depth>${near}</min_depth>
              <max_depth>${far}</max_depth>
            </plugin>
          </sensor>
        </gazebo>
      </xacro:if>
    </xacro:if>
  </xacro:macro>
  <xacro:property name="angle" value="${float('$(arg camera_angle_deg)') * pi/180}"/>
  <xacro:property name="camera_tilt" value="${float('$(arg camera_tilt_deg)') * pi/180}"/>
  <link name="cam_left_link"/>
  <link name="cam_right_link"/>
  <link name="cam_hand_link"/>
  <xacro:fixed name="left_camera_mount" parent="lift_platform" child="cam_left_link"
               xyz="0.360341 -0.036530 -1.149732" rpy="${pi} ${camera_tilt} ${-pi/2-angle}"/>
  <xacro:fixed name="right_camera_mount" parent="lift_platform" child="cam_right_link"
               xyz="0.360341 0.056365 -1.149732" rpy="${pi} ${camera_tilt} ${pi/2+angle}"/>
  <joint name="hand_camera_mount" type="fixed">
    <parent link="cutter_base_link"/>
    <child link="cam_hand_link"/>
    <xacro:wrist_camera_origin/>
  </joint>
  <xacro:rgbd_camera name="cam_left" hfov="${float('$(arg camera_hfov_deg)')*pi/180}" width="848" height="480" near="0.25" far="9.0" enabled="${'$(arg left_camera)' == 'true'}"/>
  <xacro:rgbd_camera name="cam_right" hfov="${float('$(arg camera_hfov_deg)')*pi/180}" width="848" height="480" near="0.25" far="9.0" enabled="${'$(arg right_camera)' == 'true'}"/>
  <xacro:rgbd_camera name="cam_hand" hfov="${2*atan(tan(29*pi/180)*848/480)}"
                     width="848" height="480" near="0.07" far="1.2" enabled="${'$(arg hand_camera)' == 'true'}"/>

  <gazebo><self_collide>$(arg self_collide)</self_collide></gazebo>
  <xacro:tomato_control/>
</robot>
